{
  "name": "rss-reader-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RSS Reader — a local-first RSS reader PWA. Feeds, folders and bookmarks stored on this device.",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "relay:dev": "wrangler dev relay/worker.ts",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@serenity-js/assertions": "^3.47.2",
    "@serenity-js/console-reporter": "^3.47.2",
    "@serenity-js/core": "^3.31.10",
    "@serenity-js/playwright": "^3.31.10",
    "@serenity-js/playwright-test": "^3.31.10",
    "@serenity-js/web": "^3.31.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^3.2.7",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.7",
    "workbox-window": "^7.4.1",
    "wrangler": "^3.114.17"
  }
}
